@model GroupDetailsViewModel
@{
    var g = Model.Group;
    ViewData["Title"] = g.Title;
    var isCouple = g.Type == "couple";
}
<a asp-action="Index" class="small text-muted"><i class="bi bi-arrow-left"></i> Couples &amp; groups</a>
<div class="d-flex flex-wrap align-items-center gap-3 my-3">
    <span class="gl-avatar lg"><i class="bi @(isCouple ? "bi-heart" : "bi-people")"></i></span>
    <div>
        <h1 class="gl-page-title h3">@g.Title</h1>
        <div class="d-flex gap-2 flex-wrap mt-1">
            <span class="badge badge-soft">@(isCouple ? "Couple" : "Friend group")</span>
            <span class="badge @(g.Status == "active" ? "badge-emerald" : "badge-amber")">@g.Status</span>
            @if (g.Code is not null) { <span class="badge badge-soft">Code <code class="text-success ms-1">@g.Code</code></span> }
        </div>
    </div>
    <div class="ms-auto d-flex gap-2">
        @if (!isCouple)
        {
            <form asp-action="ResetCode" asp-route-id="@g.Id" method="post" data-ask="Reset the code? The old one stops working immediately."><button class="btn btn-outline-light"><i class="bi bi-arrow-repeat me-1"></i> Reset code</button></form>
        }
        <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delGroup"><i class="bi bi-trash me-1"></i> Delete</button>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5 vstack gap-3">
        @if (!isCouple)
        {
            <form class="gl-card vstack gap-2" asp-action="Rename" asp-route-id="@g.Id" method="post">
                <h6 class="mb-0">Name</h6>
                <div class="input-group"><input class="form-control" name="name" value="@g.Name" maxlength="40" required /><button class="btn btn-primary">Rename</button></div>
            </form>
        }
        <div class="gl-card">
            <div class="d-flex align-items-center mb-2"><h6 class="mb-0">Members</h6><span class="ms-auto small text-muted">@g.Members.Count</span></div>
            @foreach (var m in g.Members)
            {
                <div class="d-flex align-items-center gap-2 py-2 border-bottom" style="border-color:var(--gl-line)!important">
                    @if (!string.IsNullOrEmpty(m.PhotoUrl)) { <img class="gl-avatar" src="@m.PhotoUrl" referrerpolicy="no-referrer" alt="" /> }
                    else { <span class="gl-avatar">@Format.Initials(m.DisplayName)</span> }
                    <a asp-controller="Users" asp-action="Details" asp-route-id="@m.Uid" class="text-white">
                        <div class="fw-semibold">@m.DisplayName @if (m.IsOwner) { <span class="badge badge-emerald ms-1">Owner</span> }</div>
                        <div class="small text-muted">@m.Email</div>
                    </a>
                    <form class="ms-auto" asp-action="RemoveMember" asp-route-id="@g.Id" method="post" data-ask="Remove @m.DisplayName? @(isCouple ? "This ends the couple." : "Their swipes in this group are deleted.")">
                        <input type="hidden" name="uid" value="@m.Uid" /><button class="btn btn-ghost btn-sm" title="Remove"><i class="bi bi-person-dash"></i></button>
                    </form>
                </div>
            }
            @if (!isCouple && g.Status == "active")
            {
                <form class="mt-3 d-flex gap-2" asp-action="AddMember" asp-route-id="@g.Id" method="post">
                    <select class="form-select" name="uid" required>
                        <option value="">Add someone…</option>
                        @foreach (var u in Model.OtherUsers.OrderBy(u => u.DisplayName)) { <option value="@u.Uid">@u.DisplayName (@u.Email)</option> }
                    </select>
                    <button class="btn btn-primary"><i class="bi bi-person-plus"></i></button>
                </form>
            }
        </div>
    </div>

    <div class="col-lg-7 vstack gap-3">
        <div class="gl-card">
            <div class="d-flex align-items-center mb-2">
                <h6 class="mb-0">Matches</h6>
                <div class="ms-auto d-flex gap-1">
                    @foreach (var k in new[] { "Watch", "Eat", "Do" }) { <span class="badge badge-soft"><i class="bi @Format.KindIcon(k) me-1"></i>@g.Matches.Count(m => m.KindLabel == k)</span> }
                </div>
            </div>
            @if (g.Matches.Count == 0) { <div class="gl-empty"><i class="bi bi-stars"></i>No matches yet</div> }
            <div class="table-responsive">
                <table class="table mb-0">
                    @foreach (var m in g.Matches)
                    {
                        <tr style="cursor:default">
                            <td><i class="bi @Format.KindIcon(m.KindLabel) text-success me-2"></i>@m.Title</td>
                            <td class="small text-muted">@m.InterestedCount of @m.MemberCount</td>
                            <td class="small text-muted">@Format.Ago(m.MatchedAt)</td>
                            <td class="text-end">
                                <form asp-action="DeleteMatch" asp-route-id="@g.Id" method="post" data-ask="Delete the match for @m.Title?">
                                    <input type="hidden" name="kind" value="@m.Kind" /><input type="hidden" name="matchId" value="@m.Id" />
                                    <button class="btn btn-ghost btn-sm" title="Delete match"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </table>
            </div>
        </div>

        <div class="gl-card">
            <h6>@(isCouple ? "Date nights" : "Meet ups")</h6>
            @if (g.Plans.Count == 0) { <div class="gl-empty"><i class="bi bi-calendar-heart"></i>Nothing planned</div> }
            @foreach (var p in g.Plans)
            {
                <div class="d-flex align-items-center gap-3 py-2 border-bottom" style="border-color:var(--gl-line)!important">
                    <div class="text-center" style="width:52px">
                        <div class="small text-muted">@p.StartAt?.ToLocalTime().ToString("MMM")</div>
                        <div class="fw-bold fs-5">@p.StartAt?.ToLocalTime().ToString("dd")</div>
                    </div>
                    <div>
                        <div class="fw-semibold">@p.Title</div>
                        <div class="small text-muted">@Format.Local(p.StartAt)@(isCouple ? "" : $" · {p.Going} going")</div>
                    </div>
                    <span class="badge @(p.Upcoming ? "badge-emerald" : "badge-soft") ms-auto">@(p.Upcoming ? "Upcoming" : "Done")</span>
                    <form asp-action="DeletePlan" asp-route-id="@g.Id" method="post" data-ask="Delete this plan?">
                        <input type="hidden" name="planId" value="@p.Id" /><button class="btn btn-ghost btn-sm"><i class="bi bi-trash"></i></button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="delGroup" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered"><form class="modal-content" asp-action="Delete" asp-route-id="@g.Id" method="post" data-confirm="DELETE">
        <div class="modal-header"><h5 class="modal-title fw-bold">Delete @g.Title?</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <p>Deletes the @(isCouple ? "couple" : "group") with all its swipes, matches, plans and notifications. Members keep their accounts. This can't be undone.</p>
            <label class="form-label">Type DELETE to confirm</label><input class="form-control" data-confirm-input autocomplete="off" />
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger" type="submit" disabled>Delete</button></div>
    </form></div>
</div>
