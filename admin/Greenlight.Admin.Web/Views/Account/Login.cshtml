@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in · Greenlight Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { min-height: 100vh; display: grid; place-items: center; background: radial-gradient(90% 70% at 15% 0%, #064E3B 0%, #111318 55%); }
        .login { width: min(420px, 92vw); }
        .mark { width: 64px; height: 64px; border-radius: 18px; background: linear-gradient(135deg, #10B981, #047857); display: grid; place-items: center; font-size: 2rem; color: #04110B; margin: 0 auto 18px; box-shadow: 0 12px 40px rgba(16,185,129,.35); }
        .google { background: #fff; color: #1f1f1f; border: 0; }
        .google:hover { background: #f1f1f1; color: #1f1f1f; }
    </style>
</head>
<body>
<div class="login gl-card p-4 p-md-5 text-center">
    <div class="mark"><i class="bi bi-check-lg"></i></div>
    <h1 class="h3 fw-bold mb-1">Greenlight Admin</h1>
    <p class="text-muted mb-4">Manage users, groups and app settings. Admin accounts only.</p>
    <form id="af">@Html.AntiForgeryToken()</form>
    <button id="signin" class="btn google w-100 py-2 d-flex align-items-center justify-content-center gap-2">
        <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        Sign in with Google
    </button>
    @if (ViewData["Expired"] is true)
    {
        <div class="small mt-3 text-warning">Your session has ended. Please sign in again.</div>
    }
    <div id="msg" class="small mt-3 text-danger" role="alert"></div>
    <p class="small text-muted mt-4 mb-0">Every change is checked by Greenlight's Cloud Functions and written to the audit log.</p>
</div>

<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.10.0/firebase-app.js";
    import { getAuth, GoogleAuthProvider, signInWithPopup, signOut } from "https://www.gstatic.com/firebasejs/11.10.0/firebase-auth.js";

    const app = initializeApp(@Html.Raw(ViewData["FirebaseConfig"]));
    const auth = getAuth(app);
    const btn = document.getElementById("signin"), msg = document.getElementById("msg");

    btn.addEventListener("click", async () => {
        msg.textContent = ""; btn.disabled = true;
        const label = btn.innerHTML; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Signing in…';
        try {
            const cred = await signInWithPopup(auth, new GoogleAuthProvider());
            const idToken = await cred.user.getIdToken();
            const token = document.querySelector('#af input[name="__RequestVerificationToken"]').value;
            const r = await fetch("/Account/Session", {
                method: "POST",
                headers: { "Content-Type": "application/json", "RequestVerificationToken": token },
                body: JSON.stringify({ idToken, refreshToken: cred.user.refreshToken, expiresIn: 3600 }),
            });
            const res = await r.json();
            if (res.ok) { location.href = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnUrl)); return; }
            msg.textContent = res.message; await signOut(auth);
        } catch (e) {
            msg.textContent = e.code === "auth/popup-closed-by-user" ? "Sign-in was cancelled." : (e.message ?? "Sign-in failed.");
        }
        btn.disabled = false; btn.innerHTML = label;
    });
</script>
</body>
</html>
