@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var name = User.Identity?.Name ?? "Admin";
    var picture = User.FindFirst("picture")?.Value;
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Greenlight Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2.1.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='9' fill='%2310B981'/><path d='M9 17l5 5 9-11' stroke='%2304110B' stroke-width='3.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<div class="gl-shell">
    <aside class="gl-sidebar">
        <a class="gl-brand" asp-controller="Dashboard" asp-action="Index"><span class="dot"><i class="bi bi-check-lg"></i></span> Greenlight <span class="badge badge-emerald ms-1" style="font-size:.6rem">ADMIN</span></a>
        <nav class="gl-nav">
            <a class="@Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a>
            <div class="section">People</div>
            <a class="@Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Users</a>
            <a class="@Active("Groups")" asp-controller="Groups" asp-action="Index"><i class="bi bi-heart"></i> Couples &amp; groups</a>
            <div class="section">App</div>
            <a class="@Active("Settings")" asp-controller="Settings" asp-action="Index"><i class="bi bi-sliders"></i> App settings</a>
            <a class="@Active("Notifications")" asp-controller="Notifications" asp-action="Index"><i class="bi bi-megaphone"></i> Notifications</a>
            <a class="@Active("Audit")" asp-controller="Audit" asp-action="Index"><i class="bi bi-clock-history"></i> Audit log</a>
            <div class="section">Maintenance</div>
            <a class="danger @Active("Danger")" asp-controller="Danger" asp-action="Index"><i class="bi bi-exclamation-octagon"></i> Danger zone</a>
        </nav>
        <div class="foot">Changes are checked and logged by Greenlight's Cloud Functions.</div>
    </aside>

    <div class="gl-main">
        <header class="gl-topbar">
            <div class="gl-search" id="openPalette"><i class="bi bi-search"></i> Search users, groups, codes… <kbd>Ctrl K</kbd></div>
            <span class="gl-pill ms-auto" id="fnStatus" title="Round trip to Greenlight's Cloud Functions"><span class="led"></span><span class="txt">Functions…</span></span>
            <div class="dropdown">
                <button class="btn btn-ghost d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                    @if (!string.IsNullOrEmpty(picture)) { <img src="@picture" class="gl-avatar" style="width:30px;height:30px" referrerpolicy="no-referrer" alt="" /> }
                    else { <span class="gl-avatar" style="width:30px;height:30px">@Format.Initials(name)</span> }
                    <span class="d-none d-md-inline">@name</span> <i class="bi bi-chevron-down small"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    <span class="dropdown-item-text small text-muted">@email</span>
                    <a class="dropdown-item" href="https://localhost:7141/scalar/v1" target="_blank"><i class="bi bi-braces me-2"></i>API reference</a>
                    <div class="dropdown-divider"></div>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button></form>
                </div>
            </div>
        </header>
        <main class="gl-content">
            @RenderBody()
        </main>
    </div>
</div>

<!-- Ctrl+K quick search -->
<div class="modal fade gl-palette" id="palette" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <div class="d-flex align-items-center gap-2 px-3 pt-3 pb-2 border-bottom" style="border-color:var(--gl-line)!important">
            <i class="bi bi-search text-muted"></i>
            <input id="paletteInput" class="form-control" placeholder="Search users, groups or codes" autocomplete="off" />
        </div>
        <div id="paletteHits" class="p-2" style="max-height:50vh;overflow:auto"><div class="gl-empty py-4"><i class="bi bi-keyboard"></i>Type at least 2 letters</div></div>
    </div></div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-4" id="toasts"></div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/datatables.net@2.1.8/js/dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2.1.8/js/dataTables.bootstrap5.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (TempData[Greenlight.Admin.Web.Controllers.BaseWebController.ToastKey] is string toast)
{
    <script>gl.toastJson(@Html.Raw(toast));</script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
