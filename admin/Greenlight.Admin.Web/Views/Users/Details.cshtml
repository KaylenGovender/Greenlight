@model UserDetailResponse
@{ ViewData["Title"] = Model.DisplayName; }
<a asp-action="Index" class="small text-muted"><i class="bi bi-arrow-left"></i> Users</a>
<div class="d-flex flex-wrap align-items-center gap-3 my-3">
    @if (!string.IsNullOrEmpty(Model.PhotoUrl)) { <img class="gl-avatar lg" src="@Model.PhotoUrl" referrerpolicy="no-referrer" alt="" /> }
    else { <span class="gl-avatar lg">@Format.Initials(Model.DisplayName)</span> }
    <div>
        <h1 class="gl-page-title h3">@Model.DisplayName</h1>
        <div class="text-muted">@Model.Email</div>
        <div class="mt-1 d-flex gap-2 flex-wrap">
            @if (Model.Disabled) { <span class="badge badge-red">Disabled</span> } else { <span class="badge badge-emerald">Active</span> }
            @foreach (var p in Model.Providers) { <span class="badge badge-soft">@(p == "google.com" ? "Google" : p == "password" ? "Email" : p)</span> }
            <span class="badge badge-soft"><i class="bi bi-phone me-1"></i>@Model.DeviceCount phone@(Model.DeviceCount == 1 ? "" : "s")</span>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <form class="gl-card vstack gap-3" asp-action="Update" asp-route-id="@Model.Uid" method="post">
            <h6 class="mb-0">Profile</h6>
            <div><label class="form-label">Name</label><input name="displayName" class="form-control" value="@Model.DisplayName" maxlength="60" required /></div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="onb" name="onboarded" value="true" @(Model.Onboarded ? "checked" : "") />
                <label class="form-check-label" for="onb">Finished onboarding</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="notif" name="notificationsEnabled" value="true" @(Model.NotificationsEnabled ? "checked" : "") />
                <label class="form-check-label" for="notif">Push notifications on</label>
            </div>
            <input type="hidden" name="onboarded" value="false" /><input type="hidden" name="notificationsEnabled" value="false" />
            <div class="small text-muted">Joined @Format.Local(Model.CreatedAt) · last active @Format.Ago(Model.LastSignInAt)</div>
            <div><button class="btn btn-primary" type="submit"><i class="bi bi-check2 me-1"></i> Save</button></div>
        </form>

        <div class="gl-card mt-3 gl-danger-card vstack gap-2">
            <h6 class="mb-0">Account</h6>
            <form asp-action="SetDisabled" asp-route-id="@Model.Uid" method="post" data-ask="@(Model.Disabled ? "Enable this account?" : "Disable this account? They'll be signed out and can't sign in.")">
                <input type="hidden" name="disabled" value="@((!Model.Disabled).ToString().ToLower())" />
                <button class="btn btn-outline-light w-100" type="submit"><i class="bi @(Model.Disabled ? "bi-unlock" : "bi-lock") me-1"></i> @(Model.Disabled ? "Enable account" : "Disable account")</button>
            </form>
            <button class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#del"><i class="bi bi-trash me-1"></i> Delete user…</button>
            <div class="small text-muted">Uid <code>@Model.Uid</code></div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="gl-card">
            <h6>Couples &amp; groups</h6>
            @if (Model.Groups.Count == 0)
            {
                <div class="gl-empty"><i class="bi bi-people"></i>Not in any couple or group</div>
            }
            @foreach (var g in Model.Groups)
            {
                <a class="d-block p-3 rounded-4 mb-2" style="background:var(--gl-zinc-high)" asp-controller="Groups" asp-action="Details" asp-route-id="@g.Id">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @(g.Type == "couple" ? "bi-heart" : "bi-people") text-success"></i>
                        <span class="fw-semibold text-white">@g.Title</span>
                        <span class="badge @(g.Status == "active" ? "badge-emerald" : "badge-soft") ms-1">@g.Status</span>
                        <span class="ms-auto small text-muted">@g.MemberCount members</span>
                    </div>
                    <div class="row g-2 mt-2">
                        @foreach (var sw in g.Swipes)
                        {
                            <div class="col-4"><div class="small text-muted"><i class="bi @Format.KindIcon(sw.Kind) me-1"></i>@sw.Kind</div>
                                <div class="text-white"><span class="text-success fw-semibold">@sw.Interested</span> yes · @sw.Passed pass</div></div>
                        }
                    </div>
                </a>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="del" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered"><form class="modal-content" asp-action="Delete" asp-route-id="@Model.Uid" method="post" data-confirm="DELETE">
        <div class="modal-header"><h5 class="modal-title fw-bold">Delete @Model.DisplayName?</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <p>This deletes their account, profile, phones and swipes, removes them from every group and ends their couple. Matches that needed their yes are recounted. This can't be undone.</p>
            <label class="form-label">Type DELETE to confirm</label><input class="form-control" data-confirm-input autocomplete="off" />
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger" type="submit" disabled>Delete user</button></div>
    </form></div>
</div>
